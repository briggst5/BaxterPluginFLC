# VS100 Knowledge MCP configuration (non-secret settings)
# Copy to ~/.config/vs100-knowledge-mcp.env and chmod 600.
#
# Authentication uses the ambient Baxter Entra identity from Windows SSO/WAM,
# Visual Studio, Azure CLI, or managed identity. Access is governed by Azure RBAC
# on the Azure AI Search service. Do not commit a filled-in copy of this file.

# Entra tenant - optional, pins sign-in to your organization directory.
AZURE_TENANT_ID=<your-entra-tenant-id>

# Azure AI Search knowledge endpoint and index.
VS100_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
VS100_SEARCH_INDEX=<your-search-index>

# VS Code only: path to the installed plugin directory. VS Code does not expand
# ${PLUGIN_ROOT} for plugin MCP servers, so the launcher reads this value to
# locate itself. %USERPROFILE%, ${HOME}, and a leading ~ are expanded, and a
# home-relative path is resolved against your home directory. Cursor does not need it.
# VS100_PLUGIN_DIR=%USERPROFILE%\.vscode\agent-plugins\dev.azure.com\FrontLineCare\Tools\_git\baxter-plugins\plugins\baxter-flc-vs100

# TLS - corporate proxy / WSL.
# REQUESTS_CA_BUNDLE=/path/to/corporate-ca.pem